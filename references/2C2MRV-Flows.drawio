        <mxCell id="docs" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;" value="The four documents — claim, audit, claim, audit:&amp;nbsp;&amp;nbsp;PSF = owner&#39;s project plan&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;PVR = auditor A&#39;s design-audit report&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;PMR = owner&#39;s measured results&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;ERVR = auditor B&#39;s performance-audit report (carries the verified quantity)" vertex="1">
          <mxGeometry height="22" width="1240" x="40" y="668" as="geometry" />
        </mxCell>
        <mxCell id="tr" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=left;" value="The three rules that make a credit trustworthy &amp;amp; distinguish us" vertex="1">
