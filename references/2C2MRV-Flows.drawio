        </mxCell>
        <mxCell id="tr1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="The party that audits a project&#39;s design is never the party that audits its performance — Certified Auditor vs Certified Creditor, at institution level." vertex="1">
          <mxGeometry height="72" width="360" x="40" y="572" as="geometry" />
        </mxCell>
        <mxCell id="tr2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="The issued quantity is the Certified Creditor&#39;s recalculation — BE − PE − LE in tCO₂e under the pinned GWP set — checked for arithmetic consistency before any decision sees it." vertex="1">
          <mxGeometry height="72" width="400" x="420" y="572" as="geometry" />
        </mxCell>
        <mxCell id="tr3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;" value="No person can mint or un-retire. Every report, decision and confirmation is published to a blockchain-based public ledger, tamper-evident." vertex="1">
          <mxGeometry height="72" width="420" x="840" y="572" as="geometry" />
        </mxCell>
